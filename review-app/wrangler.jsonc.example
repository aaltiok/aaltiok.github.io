{
  "name": "wb-private-type-review",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-10",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "review.alialtiok.com", "custom_domain": true }],
  "assets": {
    "directory": ".deploy/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "wb-private-type-review",
    "database_id": "REPLACE_WITH_CLOUDFLARE_DATABASE_ID"
  }]
}
